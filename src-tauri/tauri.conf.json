{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "reptilr",
  "version": "0.1.0",
  "identifier": "com.zicob.reptilr",
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:mydatabase.db"
      ]
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Reptilr: Lina's snake app",
        "width": 409,
        "height": 1000,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}